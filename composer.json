{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^4.3",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.10",
        "kreait/laravel-firebase": "^6.0",
        "laravel-notification-channels/webpush": "^11.0",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^4.4",
        "maatwebsite/excel": "^4.0",
        "minishlink/web-push": "^11.0",
        "pusher/pusher-php-server": "^7.7",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-permission": "^7.0",
        "stripe/stripe-php": "^18.0",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^9.0",
        "phpunit/phpunit": "^12.0"
    }
}